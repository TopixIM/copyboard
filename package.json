{
  "name": "copyboard",
  "version": "0.1.1",
  "description": "Cumulo Workflow",
  "main": "index.js",
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "calcit calcit.cirru --check-only && calcit calcit.cirru --entry server --check-only && calcit calcit.cirru analyze deprecated --summary-only && calcit calcit.cirru --entry server analyze deprecated --summary-only",
    "compile-page": "calcit calcit.cirru js",
    "dev": "vite",
    "release-page": "vite build --base=${VITE_BASE_URL:-./}",
    "server": "calcit calcit.cirru --entry server",
    "smoke-server": "node scripts/smoke-native-server.mjs",
    "watch-page": "calcit -w calcit.cirru js"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:mvc-works/cumulo-workflow.git"
  },
  "author": "jiyinyiyong",
  "license": "MIT",
  "dependencies": {
    "@calcit/procs": "0.27.0",
    "axios": "^1.18.0",
    "mime": "^4.1.0"
  },
  "devDependencies": {
    "bottom-tip": "^0.1.5",
    "copy-text-to-clipboard": "^3.2.2",
    "feather-icons": "^4.29.2",
    "spark-md5": "^3.0.2",
    "url-parse": "^1.5.10",
    "vite": "^8.0.16"
  }
}
